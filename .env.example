# URL flow registrasi atau trial resmi wazePOS.
NEXT_PUBLIC_TRIAL_URL=

# Nomor WhatsApp resmi dalam format internasional tanpa tanda +, contoh: 6281234567890.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Origin website untuk metadata, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database PostgreSQL. Untuk Vercel/Supabase gunakan URL pooler dengan sslmode=require.
DATABASE_URL=postgresql://postgres.opcsqxeeluipjuwvtdmy:Wijayakusuma@23@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Wajib diganti dengan secret acak minimal 32 karakter pada setiap environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Midtrans Snap. Gunakan Server Key sandbox dan false selama pengembangan.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# URL publik webhook, contoh: https://app.example.com/api/payments/midtrans/webhook
# Kosongkan saat localhost belum diekspos ke internet.
MIDTRANS_NOTIFICATION_URL=

# Opsional: endpoint backend/CRM untuk menerima lead dalam format JSON.
LEAD_WEBHOOK_URL=

# Opsional: secret Bearer token untuk endpoint webhook.
LEAD_WEBHOOK_SECRET=
