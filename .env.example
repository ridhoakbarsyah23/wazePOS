# URL flow registrasi atau trial resmi wazePOS.
NEXT_PUBLIC_TRIAL_URL=

# Nomor WhatsApp resmi dalam format internasional tanpa tanda +, contoh: 6281234567890.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Origin website untuk metadata, sitemap, dan Open Graph.
# Di Vercel gunakan domain produksi HTTPS yang persis, tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database PostgreSQL.
# Pengembangan lokal: biarkan menunjuk ke Docker compose (lihat compose.yaml).
# Service `app` di compose membaca APP_DATABASE_URL (host `postgres:5432` dari
# dalam container). Jangan isi APP_DATABASE_URL di file .env lokal agar
# `docker compose --profile prod up` tidak tertukar dengan URL host.
# Deployment (Vercel/Supabase): set URL pooler dengan sslmode=require di env deployment,
# JANGAN di file .env ini, agar migrasi lokal tidak pernah menyentuh database produksi.
DATABASE_URL=postgresql://wazepos:wazepos@127.0.0.1:5434/wazepos

# Wajib diganti dengan secret acak minimal 32 karakter dan disimpan sebagai secret Vercel.
BETTER_AUTH_SECRET=
# Opsional: kosongkan agar mengikuti NEXT_PUBLIC_SITE_URL (lihat lib/auth/auth.ts).
# Isi eksplisit hanya bila origin auth berbeda dari site URL.
BETTER_AUTH_URL=

# Email akun terverifikasi yang boleh membuka /admin. Pisahkan beberapa email dengan koma.
# Server-only: jangan gunakan awalan NEXT_PUBLIC_. Kosongkan sampai akun admin_internal
# benar-benar sudah diprovisioning dan memiliki email_verified=true.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_SEED_PASSWORD=

# Google OAuth untuk tombol Single Sign-On. Simpan Client Secret hanya di server.
# Redirect URI lokal: http://localhost:3000/api/auth/callback/google
# Redirect URI produksi: https://DOMAIN-ANDA/api/auth/callback/google
# GOOGLE_CLIENT_SECRET tidak boleh memakai awalan NEXT_PUBLIC_ atau masuk Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email transaksional Resend untuk tautan reset kata sandi.
# Gunakan alamat pengirim dari domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=wazePOS <no-reply@domain-anda.com>

# Midtrans Snap. Gunakan Server Key sandbox dan false selama pengembangan.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# URL publik webhook, contoh: https://app.example.com/api/payments/midtrans/webhook
# Kosongkan saat localhost belum diekspos ke internet.
MIDTRANS_NOTIFICATION_URL=

# Opsional: endpoint backend/CRM untuk menerima lead dalam format JSON.
LEAD_WEBHOOK_URL=

# Opsional: secret Bearer token untuk endpoint webhook.
LEAD_WEBHOOK_SECRET=
